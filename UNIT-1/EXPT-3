from transformers import AutoTokenizer
text = "Generative AI is interesting!"
bert_tokenizer = AutoTokenizer.from_pretrained(
    "bert-base-uncased"
)
gpt_tokenizer = AutoTokenizer.from_pretrained(
    "openai-community/gpt2"
)
print("BERT tokens:")
print(bert_tokenizer.tokenize(text))
print("\nGPT tokens:")
print(gpt_tokenizer.tokenize(text))
